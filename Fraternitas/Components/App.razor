@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <title>Fraternitas</title>
    <link rel="stylesheet" href="@($"app.css?v={AppCssVersion}")" />
    <HeadOutlet />
</head>
<body>
    <Routes />
</body>
</html>

@code {
    // Changes whenever the CSS content changes, even when deployment copies
    // preserve source file timestamps. Prevents browsers from caching old CSS.
    private string AppCssVersion => Convert.ToHexString(
        System.Security.Cryptography.SHA256.HashData(
            System.IO.File.ReadAllBytes(
                System.IO.Path.Combine(HostEnvironment.WebRootPath, "app.css"))))[..12];
}
