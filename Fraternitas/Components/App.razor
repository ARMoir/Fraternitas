@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <title>Fraternitas</title>
    <!-- Use the bundled free Material stylesheet so scheduler layout and icon fonts are available on first paint. -->
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/material-base.css" />
    <link rel="stylesheet" href="@($"app.css?v={AppCssVersion}")" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
</body>
</html>

@code {
    // Changes whenever the CSS content changes, even when deployment copies
    // preserve source file timestamps. Prevents browsers from caching old CSS.
    private string AppCssVersion => Convert.ToHexString(
        System.Security.Cryptography.SHA256.HashData(
            System.IO.File.ReadAllBytes(
                System.IO.Path.Combine(HostEnvironment.WebRootPath, "app.css"))))[..12];
}
