@page "/"
@attribute [Authorize]
@inject IDbContextFactory<FraternityDb> DbFactory

<PageTitle>Home | Fraternitas</PageTitle>

<section class="hero">
    <div class="eyebrow">MEN OF ADVENT</div>
    <h1>Grow in faith. Walk together.</h1>
    <p>A place for prayer, scripture, accountability and fraternity throughout Advent and beyond.</p>
    <div class="hero-actions">
        <a class="action" href="/calendar">View calendar</a>
        <a class="action secondary" href="/discussions">Join the conversation</a>
    </div>
</section>

<div class="dashboard-grid">
    <section class="panel">
        <div class="section-head">
            <h2>On the calendar</h2>
            <a href="/calendar">Full calendar</a>
        </div>
        <p class="muted small">@weekStart.ToString("MMM d") – @weekStart.AddDays(6).ToString("MMM d, yyyy") · Eastern Time</p>
        @if (visibleEvents.Count == 0)
        {
            <p class="muted">No events scheduled for this week.</p>
        }
        @foreach (var ev in visibleEvents)
        {
            <a class="event-row" href="@($"/events/{ev.Id}")">
                <span class="date-tile"><strong>@ev.StartLocal.ToString("dd")</strong><small>@ev.StartLocal.ToString("MMM")</small></span>
                <span>
                    <strong>@ev.Title</strong>
                    <small>@ev.StartLocal.ToString("ddd") · @(ev.StartLocal.TimeOfDay == TimeSpan.Zero && ev.EndLocal == ev.StartLocal.Date.AddDays(1) ? "All day" : ev.StartLocal.ToString("h:mm tt") + " ET") · @ev.Category</small>
                </span>
            </a>
        }
    </section>
    <section class="panel">
        <div class="section-head"><h2>Our commitments</h2><span class="subtle">Daily & weekly</span></div>
        <div class="commitment"><span>☀</span><div><strong>Silent prayer</strong><p>20 minutes each day, prioritizing quiet and listening.</p></div></div>
        <div class="commitment"><span>✝</span><div><strong>Daily Examen</strong><p>Reflect on God's presence and your response to grace.</p></div></div>
        <div class="commitment"><span>◷</span><div><strong>Wednesday & Friday fasting · Until 4 PM</strong><p>Fast until 4:00 PM Eastern, or follow the alternative of two small meals and one normal meal. Wednesdays are also meatless.</p></div></div>
        <div class="commitment"><span>▣</span><div><strong>Phone-off or no TV</strong><p>Turn off your phone when it is not needed for work or ministry. Giving up television is an acceptable alternative.</p></div></div>
    </section>
</div>

<div class="dashboard-grid">
    <section class="panel">
        <div class="section-head"><h2>The Joyful Mysteries</h2><a href="/readings">All readings</a></div>
        @foreach (var reading in readings)
        {
            <a class="list-row" href="/readings">
                <span class="number">@reading.Week</span>
                <span><strong>@reading.Title</strong><small>@reading.Scripture</small></span>
            </a>
        }
    </section>
    <section class="panel">
        <div class="section-head"><h2>Recent discussion</h2><a href="/discussions">All posts</a></div>
        @if (discussions.Count == 0)
        {
            <p class="muted">Start a conversation or share a reflection from this week's scripture.</p>
        }
        @foreach (var post in discussions)
        {
            <a class="list-row" href="@($"/discussions/{post.Id}")">
                <span class="number">✦</span>
                <span><strong>@post.Title</strong><small>@post.Author?.DisplayName · @post.CreatedUtc.ToLocalTime().ToString("MMM d")</small></span>
            </a>
        }
    </section>
</div>

@code {
    private List<CalendarEvent> weekEvents = [];
    private List<CalendarEvent> visibleEvents => weekEvents
        .Where(e => e.Category != "Prayer" || e.Title != "Daily prayer & Examen").ToList();
    private DateTime weekStart;
    private List<Reading> readings = [];
    private List<Discussion> discussions = [];

    private static DateTime StartOfWeek(DateTime date) =>
        date.Date.AddDays(-(((int)date.DayOfWeek + 6) % 7));

    protected override async Task OnInitializedAsync()
    {
        weekStart = StartOfWeek(GroupClock.Now);
        await using var db = await DbFactory.CreateDbContextAsync();
        readings = await db.Readings.AsNoTracking().OrderBy(r => r.Week).ToListAsync();
        discussions = await db.Discussions.AsNoTracking().Include(p => p.Author)
            .Where(p => p.GroupId == 1).OrderByDescending(p => p.CreatedUtc)
            .Take(5).ToListAsync();

        await LoadWeekAsync();
        // When the current week has no visible events, show the next scheduled week.
        // This keeps the approaching Monday gathering visible before Advent begins.
        if (visibleEvents.Count == 0)
        {
            var next = await db.CalendarEvents.AsNoTracking()
                .Where(e => e.GroupId == 1 && e.StartLocal >= weekStart.AddDays(7)
                    && (e.Category != "Prayer" || e.Title != "Daily prayer & Examen"))
                .OrderBy(e => e.StartLocal)
                .Select(e => (DateTime?)e.StartLocal)
                .FirstOrDefaultAsync();
            if (next.HasValue)
            {
                weekStart = StartOfWeek(next.Value);
                await LoadWeekAsync();
            }
        }
    }

    private async Task LoadWeekAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var end = weekStart.AddDays(7);
        weekEvents = await db.CalendarEvents.AsNoTracking()
            .Where(e => e.GroupId == 1 && e.StartLocal < end && e.EndLocal > weekStart)
            .OrderBy(e => e.StartLocal).ThenBy(e => e.Category)
            .ToListAsync();
    }

}
