@page "/discussions"
@attribute [Authorize]
@inject IDbContextFactory<FraternityDb> DbFactory

<PageTitle>Discussions | Fraternitas</PageTitle>
<div class="page-head">
    <div class="eyebrow">FRATERNITY</div>
    <h1>Group discussions</h1>
    <p>Scripture reflections, prayer intentions and conversation between meetings.</p>
</div>

@if (PinError == "failed")
{
    <p class="error" role="alert">The Catholic verse could not be pinned. Try again or choose another verse.</p>
}

<section class="panel">
    <div class="section-head">
        <h2>Start a discussion</h2>
        <a class="action secondary compact" href="#bible-browser">📖 Browse &amp; pin Scripture</a>
    </div>
    <form method="post" action="/discussions/create" data-enhance="false">
        <AntiforgeryToken />
        <label>Topic<input name="title" maxlength="150"
                           placeholder="What would you like to discuss?" required /></label>
        <label>Your message<textarea name="body" rows="4" maxlength="6000" required></textarea></label>
        @if (PostError == "invalid")
        {
            <p class="error" role="alert">Enter a topic and a message before posting.</p>
        }
        <button class="action" type="submit">Post discussion</button>
    </form>
</section>

<BibleBrowser BookQuery="@BibleBook" ChapterQuery="@BibleChapter" VerseQuery="@BibleVerse" />

<section class="panel">
    <div class="section-head"><h2>Recent conversations</h2><span class="muted">@posts.Count topics</span></div>
    @if (posts.Count == 0) { <p class="muted">Be the first to share a reflection with the group.</p> }
    @foreach (var post in posts)
    {
        <a class="discussion-row" href="@($"/discussions/{post.Id}")">
            <div><strong>@post.Title</strong>
                <p>@(post.Body.Length > 230 ? post.Body[..230] + "…" : post.Body)</p>
                <small>@(post.Author?.DisplayName ?? "Member") · @post.CreatedUtc.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")
                    · @post.Replies.Count replies</small></div>
            <span aria-hidden="true">›</span>
        </a>
    }
</section>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "error")]
    public string? PostError { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "pin")]
    public string? PinError { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "book")]
    public string? BibleBook { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "chapter")]
    public int? BibleChapter { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "verse")]
    public int? BibleVerse { get; set; }

    private List<Discussion> posts = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        posts = await db.Discussions.AsNoTracking().Include(d => d.Author)
            .Include(d => d.Replies).Where(d => d.GroupId == 1)
            .OrderByDescending(d => d.CreatedUtc).Take(100).ToListAsync();
    }
}
