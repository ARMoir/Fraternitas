@page "/documents"
@attribute [Authorize]
@inject IDbContextFactory<FraternityDb> DbFactory

<PageTitle>Documents | Fraternitas</PageTitle>
<div class="page-head">
    <div class="eyebrow">SHARED RESOURCES</div>
    <h1>Group documents</h1>
    <p>Prayer guides, Sacred Scripture notes, and PDFs shared by members. Files are accessible only to signed-in members.</p>
</div>
<section class="panel">
    <h2>Upload a document</h2>
    @* Native multipart form: doesn't rely on a working Blazor Server circuit.
       The endpoint validates sign-in, antiforgery token, extension, and file size. *@
    <form method="post" action="/documents/upload" enctype="multipart/form-data" data-enhance="false">
        <AntiforgeryToken />
        <label for="document-event">Attach to meeting (optional)
            <select id="document-event" name="eventId">
                <option value="">General resource</option>
                @foreach (var ev in events)
                {
                    <option value="@ev.Id">@ev.Title (@ev.StartLocal.ToString("MMM d"))</option>
                }
            </select>
        </label>
        <label for="document-file">Choose a document</label>
        <input id="document-file" type="file" name="document"
               accept=".pdf,.docx,.txt,.png,.jpg,.jpeg" required />
        <p class="muted small">PDF, Word (.docx), plain text, and images only. Maximum 10 MB.</p>
        <button class="action" type="submit">Upload document</button>
    </form>
    @if (uploadMessage is not null)
    {
        <p role="status" class="@(UploadResult == "success" ? "upload-success" : "error")">@uploadMessage</p>
    }
</section>
<section class="panel">
    <div class="section-head"><h2>Resource library</h2><span class="muted">@documents.Count files</span></div>
    @if (documents.Count == 0)
    {
        <p class="muted">No files uploaded yet. Choose a document above and click Upload document.</p>
    }
    @foreach (var doc in documents)
    {
        <a class="list-row" href="@($"/resources/file/{doc.Id}")">
            <span class="number">↓</span>
            <span><strong>@doc.FileName</strong>
                <small>@(doc.Event?.Title ?? "General resource") · @(doc.UploadedBy?.DisplayName ?? "Member")
                    · @doc.UploadedUtc.ToLocalTime().ToString("MMM d, yyyy") · @(doc.Length / 1024) KB</small></span>
        </a>
    }
</section>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "upload")]
    public string? UploadResult { get; set; }

    private string? uploadMessage => UploadResult switch
    {
        "success" => "Document uploaded successfully. It is now available in the Resource library.",
        "invalid" => "Choose a supported file between 1 byte and 10 MB.",
        "event" => "The selected meeting is no longer available. Please choose another.",
        "failed" => "Upload failed. Please try again.",
        _ => null
    };

    private List<SharedDocument> documents = [];
    private List<CalendarEvent> events = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        documents = await db.SharedDocuments.AsNoTracking().Include(d => d.Event)
            .Include(d => d.UploadedBy).Where(d => d.GroupId == 1)
            .OrderByDescending(d => d.UploadedUtc).Take(200).ToListAsync();
        events = await db.CalendarEvents.AsNoTracking().Where(e => e.GroupId == 1)
            .OrderByDescending(e => e.StartLocal).ToListAsync();
    }
}
