@page "/calendar"
@attribute [Authorize]
@inject IDbContextFactory<FraternityDb> DbFactory
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject UserPreferencesService Preferences
@inject MemberAccessService Access
@inject HolidayCalendarService Holidays

<PageTitle>Calendar | Fraternitas</PageTitle>
<div class="page-head">
    <div class="eyebrow">GROUP CALENDAR</div>
    <h1>Our shared calendar</h1>
    <p>Prayer, fasting, Sacred Scripture, and fellowship in Christ. All times are Eastern.</p>
</div>
<div id="calendar-top" class="panel calendar-panel">
    @if (EventResult == "deleted")
    {
        <p class="upload-success" role="status">The event was removed from the group calendar.</p>
    }
    <div class="calendar-toolbar">
        @if (canCreate)
        {
            <a class="action compact" href="@CreateSlotUrl(selectedDate.Date.AddHours(20))">+ Add event</a>
            <a class="action secondary compact" href="/readings">📌 Pin Scripture</a>
        }
        @* This is a real HTTP POST, not a Blazor-only event. It works even when
           the server-side Blazor circuit has not connected or reconnects. *@
        <form method="post" action="/calendar/preferences/daily-prayer" class="calendar-preference-form">
            <AntiforgeryToken />
            <input type="hidden" name="calendarView" value="@selectedView" />
            <input type="hidden" name="calendarDate" value="@selectedDate.ToString("yyyy-MM-dd")" />
            <label class="calendar-toggle">
                <input type="checkbox" name="showDailyPrayer" value="true"
                       checked="@showDailyPrayer" onchange="this.form.requestSubmit()" />
                Show daily prayer, examination of conscience, and sacrifices
            </label>
            <button class="action secondary compact" type="submit">Apply</button>
        </form>
    </div>
    <form method="post" action="/calendar/preferences/holidays" class="calendar-preference-form holiday-preferences">
        <AntiforgeryToken />
        <input type="hidden" name="calendarView" value="@selectedView" />
        <input type="hidden" name="calendarDate" value="@selectedDate.ToString("yyyy-MM-dd")" />
        <label class="calendar-toggle"><input type="checkbox" name="showUsHolidays" value="true" checked="@showUsHolidays" onchange="this.form.requestSubmit()" /> Show US holidays</label>
        <label class="calendar-toggle"><input type="checkbox" name="showCatholicHolidays" value="true" checked="@showCatholicHolidays" onchange="this.form.requestSubmit()" /> Show Catholic holidays &amp; saints</label>
        <details class="calendar-category-filters">
            <summary>Event types</summary>
            <div class="calendar-preference-form">
                @foreach (var category in UserPreferencesService.CalendarEventCategories)
                {
                    <label class="calendar-toggle"><input type="checkbox" name="showCategory" value="@category" checked="@(!hiddenCategories.Contains(category))" onchange="this.form.requestSubmit()" /> @category</label>
                }
            </div>
        </details>
        <button class="action secondary compact" type="submit">Apply</button>
    </form>
    @if (showCatholicHolidays && catholicUnavailable)
    {
        <p class="muted small">Some Catholic observances are temporarily unavailable. Group events and US holidays are unaffected.</p>
    }
    @if (showCatholicHolidays && catholicStale)
    {
        <p class="muted small">Showing cached Catholic observances while the source is unavailable.</p>
    }
    @if (canCreate)
    {
        <p class="calendar-slot-hint">Select an empty day or an hourly time slot to add an event.</p>
    }
    <div class="frat-calendar-navigation" aria-label="Calendar navigation">
        <div class="frat-calendar-period">
            <a class="frat-calendar-nav-button" href="@CalendarUrl(selectedView, PreviousDate)" aria-label="Previous period">‹</a>
            <a class="frat-calendar-nav-button" href="@CalendarUrl(selectedView, NextDate)" aria-label="Next period">›</a>
            <a class="frat-calendar-today" href="@CalendarUrl(selectedView, GroupClock.Now.Date)">Today</a>
            <strong>@PeriodLabel</strong>
        </div>
        <div class="frat-calendar-view-options" aria-label="Calendar view">
            <a class="@(selectedView == "day" ? "active" : "")"
               href="@CalendarUrl("day", selectedDate)">Day</a>
            <a class="@(selectedView == "week" ? "active" : "")"
               href="@CalendarUrl("week", selectedDate)">Week</a>
            <a class="@(selectedView == "month" ? "active" : "")"
               href="@CalendarUrl("month", selectedDate)">Month</a>
        </div>
    </div>
    @if (selectedView == "month")
    {
        <div class="frat-calendar-month" role="table" aria-label="@PeriodLabel">
            <div class="frat-calendar-grid">
                @foreach (var weekday in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
                {
                    <div class="frat-calendar-weekday" role="columnheader">@weekday</div>
                }
                @foreach (var day in MonthDays)
                {
                    var dayEvents = EventsOn(day);
                    <div class="frat-calendar-day @(day.Month == selectedDate.Month ? "" : "frat-calendar-other-month")"
                         role="cell">
                        @if (canCreate)
                        {
                            <a class="frat-calendar-slot-overlay" href="@CreateSlotUrl(day.Date.AddHours(20))"
                               aria-label="@($"Add an event on {day:dddd, MMMM d, yyyy}")"
                               title="Add an event on this day"></a>
                        }
                        <a class="frat-calendar-day-number @(day == GroupClock.Now.Date ? "is-today" : "")"
                           href="@CalendarUrl("day", day)" aria-label="@day.ToString("dddd, MMMM d, yyyy")">
                            @day.Day
                        </a>
                        <div class="frat-calendar-appointments">
                            @foreach (var ev in dayEvents.Take(5))
                            {
                                <a class="@EventCssClass(ev)" href="@EventDetailsUrl(ev.Id)"
                                   title="@ev.Title">@ev.Title</a>
                            }
                            @foreach (var holiday in ObservancesOn(day).Take(2))
                            {
                                <span class="@HolidayCss(holiday)" title="@HolidayTitle(holiday)">@holiday.Name</span>
                            }
                            @if (ObservancesOn(day).Count > 2)
                            {
                                <a class="frat-calendar-more" href="@CalendarUrl("day", day)">More observances</a>
                            }
                            @if (dayEvents.Count > 5)
                            {
                                <a class="frat-calendar-more" href="@CalendarUrl("day", day)">
                                    View @(dayEvents.Count - 5) more
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (selectedView == "week")
    {
        <div class="frat-calendar-week">
            @foreach (var day in WeekDays)
            {
                var dayEvents = EventsOn(day);
                <section class="frat-calendar-week-day">
                    <h3><a href="@CalendarUrl("day", day)">@day.ToString("ddd, MMM d")</a></h3>
                    @foreach (var ev in dayEvents)
                    {
                        <a class="@EventCssClass(ev)" href="@EventDetailsUrl(ev.Id)"
                           title="@ev.Title">@ev.Title</a>
                    }
                    @foreach (var holiday in ObservancesOn(day))
                    {
                        <span class="@HolidayCss(holiday)" title="@HolidayTitle(holiday)">@holiday.Name</span>
                    }
                    @if (dayEvents.Count == 0 && ObservancesOn(day).Count == 0) { <p class="muted small">No events</p> }
                    @if (canCreate)
                    {
                        <div class="frat-calendar-slot-list" aria-label="@($"Time slots for {day:dddd, MMMM d}")">
                            @foreach (var hour in CalendarHours)
                            {
                                var slot = day.Date.AddHours(hour);
                                <a class="frat-calendar-hour-slot" href="@CreateSlotUrl(slot)"
                                   aria-label="@($"Add event on {day:dddd, MMMM d} at {slot:h:mm tt}")">
                                    <span>@slot.ToString("h tt")</span><span aria-hidden="true">+</span>
                                </a>
                            }
                        </div>
                    }
                </section>
            }
        </div>
    }
    else
    {
        <section class="frat-calendar-single-day">
            <h2>@selectedDate.ToString("dddd, MMMM d, yyyy")</h2>
            @foreach (var holiday in ObservancesOn(selectedDate))
            {
                <div class="@HolidayCss(holiday)"><strong>@holiday.Name</strong><small>@HolidayTitle(holiday)</small></div>
            }
            @if (EventsOn(selectedDate).Count == 0 && ObservancesOn(selectedDate).Count == 0)
            {
                <p class="muted">No events scheduled for this day.</p>
            }
            @foreach (var ev in EventsOn(selectedDate))
            {
                <a class="@EventCssClass(ev)" href="@EventDetailsUrl(ev.Id)">
                    <strong>@ev.Title</strong>
                    <small>@EventTime(ev)</small>
                </a>
            }
            @if (canCreate)
            {
                <h3 class="frat-calendar-slots-title">Select a time to add an event</h3>
                <div class="frat-calendar-day-slots">
                    @foreach (var hour in CalendarHours)
                    {
                        var slot = selectedDate.Date.AddHours(hour);
                        <a class="frat-calendar-hour-slot" href="@CreateSlotUrl(slot)"
                           aria-label="@($"Add event at {slot:h:mm tt} on {slot:MMMM d}")">
                            <span>@slot.ToString("h:mm tt")</span><span aria-hidden="true">+</span>
                        </a>
                    }
                </div>
            }
        </section>
    }
</div>

@* These are URL-fragment-controlled windows, so opening and closing them
   works with ordinary links, even when Blazor Server is disconnected. *@
@if (canCreate)
{
    <div id="create-event" class="calendar-native-modal">
        <a class="calendar-native-backdrop" href="@CloseModalUrl" aria-label="Close new event window"></a>
        <section class="panel calendar-native-dialog" role="dialog" aria-modal="true" aria-labelledby="create-event-title">
            <div class="section-head">
                <h2 id="create-event-title">Add calendar event</h2>
                <a class="calendar-native-close" href="@CloseModalUrl" aria-label="Close">✕</a>
            </div>
            @if (CreateResult == "invalid")
            {
                <p class="error" role="alert">Please enter a valid title, dates, and event information.</p>
            }
            @if (CreateResult == "failed")
            {
                <p class="error" role="alert">Could not save the event. Please try again.</p>
            }
            <form method="post" action="/calendar/events/create" data-enhance="false">
                <AntiforgeryToken />
                <input type="hidden" name="calendarView" value="@selectedView" />
                <input type="hidden" name="calendarDate" value="@selectedDate.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="slot" value="@NewEventStart.ToString("yyyy-MM-ddTHH:mm")" />
                <label>Title
                    <input name="title" maxlength="150" placeholder="e.g. Advent prayer gathering" required />
                </label>
                <div class="two-columns">
                    <label>Start (Eastern)
                        <input type="datetime-local" name="startLocal"
                               value="@NewEventStart.ToString("yyyy-MM-ddTHH:mm")" required />
                    </label>
                    <label>End (Eastern)
                        <input type="datetime-local" name="endLocal"
                               value="@NewEventStart.AddHours(1).ToString("yyyy-MM-ddTHH:mm")" required />
                    </label>
                </div>
                <label>Type
                    <select name="category">
                        <option>Meeting</option><option>Fasting</option><option>Prayer</option>
                        <option>Fellowship</option><option>Scripture</option><option>Other</option>
                    </select>
                </label>
                <label>Reading
                    <select name="readingId">
                        <option value="">None</option>
                        @foreach (var reading in readings)
                        {
                            <option value="@reading.Id">@reading.Title</option>
                        }
                    </select>
                </label>
                <label>Sacred Scripture reference
                    <input name="scripture" maxlength="100" placeholder="Luke 1:26–38" />
                </label>
                <label>Meeting link
                    <input name="meetingUrl" type="url" maxlength="1000" placeholder="https://..." />
                </label>
                <label>Description
                    <textarea name="description" rows="4" maxlength="5000"></textarea>
                </label>
                <div class="button-row">
                    <button class="action" type="submit">Save event</button>
                    <a class="action secondary" href="@CloseModalUrl">Cancel</a>
                </div>
            </form>
        </section>
    </div>
}

@foreach (var ev in visibleEvents)
{
    <div id="@($"event-{ev.Id:N}")" class="calendar-native-modal">
        <a class="calendar-native-backdrop" href="@CloseModalUrl" aria-label="Close event details"></a>
        <section class="panel calendar-native-dialog" role="dialog" aria-modal="true"
                 aria-label="@ev.Title">
            <div class="section-head">
                <div>
                    <div class="eyebrow">@ev.Category.ToUpperInvariant()</div>
                    <h2>@ev.Title</h2>
                </div>
                <a class="calendar-native-close" href="@CloseModalUrl" aria-label="Close">✕</a>
            </div>
            @if (ev.StartLocal.TimeOfDay == TimeSpan.Zero
                && ev.EndLocal == ev.StartLocal.Date.AddDays(1))
            {
                <p><strong>@ev.StartLocal.ToString("dddd, MMMM d, yyyy")</strong> · All-day observance</p>
            }
            else
            {
                <p><strong>@ev.StartLocal.ToString("dddd, MMMM d, yyyy")</strong>
                    · @ev.StartLocal.ToString("h:mm tt")–@ev.EndLocal.ToString("h:mm tt") Eastern</p>
            }
            @if (!string.IsNullOrWhiteSpace(ev.Scripture))
            {
                <p><strong>Sacred Scripture:</strong> @ev.Scripture</p>
            }
            @if (!string.IsNullOrWhiteSpace(ev.Description))
            {
                <p class="pre-line">@ev.Description</p>
            }
            <div class="button-row">
                <a class="action secondary" href="@($"/events/{ev.Id}")">Full details &amp; documents</a>
                @if (!string.IsNullOrWhiteSpace(ev.MeetingUrl))
                {
                    <a class="action secondary" href="@ev.MeetingUrl" target="_blank"
                       rel="noopener noreferrer">Join meeting</a>
                }
                @if (CanEdit(ev))
                {
                    <a class="action" href="@EditEventUrl(ev.Id)">Edit event</a>
                }
                <a class="action secondary" href="@CloseModalUrl">Close</a>
            </div>
        </section>
    </div>
}

@if (EditingEvent is { } editingEvent && CanEdit(editingEvent))
{
    <div id="edit-event" class="calendar-native-modal">
        <a class="calendar-native-backdrop" href="@EventDetailsUrl(editingEvent.Id)" aria-label="Back to event details"></a>
        <section class="panel calendar-native-dialog calendar-event-editor" role="dialog" aria-modal="true"
                 aria-labelledby="edit-event-title">
            <div class="section-head">
                <div>
                    <div class="eyebrow">CALENDAR EVENT</div>
                    <h2 id="edit-event-title">Edit event</h2>
                    <p class="muted small">@editingEvent.Title</p>
                </div>
                <a class="calendar-native-close" href="@EventDetailsUrl(editingEvent.Id)" aria-label="Back to details">✕</a>
            </div>
            @if (EditError == "invalid")
            {
                <p class="error" role="alert">Please enter a valid title, dates, and event information.</p>
            }
            <form method="post" action="@($"/calendar/events/{editingEvent.Id}/update")" data-enhance="false">
                <AntiforgeryToken />
                <input type="hidden" name="calendarModal" value="true" />
                <input type="hidden" name="calendarView" value="@selectedView" />
                <input type="hidden" name="calendarDate" value="@selectedDate.ToString("yyyy-MM-dd")" />
                <label>Title
                    <input name="title" maxlength="150" value="@editingEvent.Title" required />
                </label>
                <div class="two-columns">
                    <label>Start (Eastern)
                        <input type="datetime-local" name="startLocal"
                               value="@editingEvent.StartLocal.ToString("yyyy-MM-ddTHH:mm")" required />
                    </label>
                    <label>End (Eastern)
                        <input type="datetime-local" name="endLocal"
                               value="@editingEvent.EndLocal.ToString("yyyy-MM-ddTHH:mm")" required />
                    </label>
                </div>
                <label>Type
                    <select name="category">
                        @foreach (var category in EventCategories)
                        {
                            <option value="@category" selected="@(editingEvent.Category == category)">@category</option>
                        }
                    </select>
                </label>
                <label>Reading
                    <select name="readingId">
                        <option value="">None</option>
                        @foreach (var reading in readings)
                        {
                            <option value="@reading.Id" selected="@(editingEvent.ReadingId == reading.Id)">@reading.Title</option>
                        }
                    </select>
                </label>
                <label>Sacred Scripture reference
                    <input name="scripture" maxlength="100" value="@editingEvent.Scripture" />
                </label>
                <label>Meeting link
                    <input name="meetingUrl" type="url" maxlength="1000" value="@editingEvent.MeetingUrl" />
                </label>
                <label>Description
                    <textarea name="description" rows="4" maxlength="5000">@editingEvent.Description</textarea>
                </label>
                <div class="button-row">
                    <button class="action" type="submit">Save changes</button>
                    <a class="action secondary" href="@EventDetailsUrl(editingEvent.Id)">Cancel</a>
                </div>
            </form>
            <details class="calendar-edit-delete">
                <summary>Delete event</summary>
                <p class="muted small">This removes the event from the calendar. Its documents and discussions remain available to the group.</p>
                <form method="post" action="@($"/calendar/events/{editingEvent.Id}/delete")" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="calendarModal" value="true" />
                    <input type="hidden" name="calendarView" value="@selectedView" />
                    <input type="hidden" name="calendarDate" value="@selectedDate.ToString("yyyy-MM-dd")" />
                    <label class="calendar-delete-confirm">
                        <input type="checkbox" name="confirmDelete" value="yes" required />
                        I understand this event will be deleted.
                    </label>
                    <button class="danger-button" type="submit">Delete event</button>
                </form>
            </details>
        </section>
    </div>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "create")]
    public string? CreateResult { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "event")]
    public string? EventResult { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "date")]
    public string? DateQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "slot")]
    public string? SlotQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "edit")]
    public string? EditQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "editError")]
    public string? EditError { get; set; }

    private static readonly int[] CalendarHours = Enumerable.Range(8, 14).ToArray();
    private static readonly string[] EventCategories =
        ["Meeting", "Fasting", "Prayer", "Fellowship", "Scripture", "Other"];

    private string selectedView = "month";
    private DateTime selectedDate = GroupClock.Now.Date;

    protected override void OnParametersSet()
    {
        selectedView = ViewQuery is "day" or "week" or "month" ? ViewQuery : "month";
        selectedDate = DateTime.TryParseExact(DateQuery, "yyyy-MM-dd",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var date)
            && date.Year is >= 2000 and <= 2100
            ? date.Date : GroupClock.Now.Date;
    }

    private static DateTime StartOfWeek(DateTime date) =>
        date.Date.AddDays(-(((int)date.DayOfWeek + 6) % 7));

    private IEnumerable<DateTime> MonthDays
    {
        get
        {
            var first = new DateTime(selectedDate.Year, selectedDate.Month, 1);
            var last = first.AddMonths(1).AddDays(-1);
            var start = StartOfWeek(first);
            var end = StartOfWeek(last).AddDays(6);
            return Enumerable.Range(0, (end - start).Days + 1)
                .Select(i => start.AddDays(i));
        }
    }

    private IEnumerable<DateTime> WeekDays =>
        Enumerable.Range(0, 7).Select(i => StartOfWeek(selectedDate).AddDays(i));

    private DateTime PreviousDate => selectedView switch
    {
        "day" => selectedDate.AddDays(-1),
        "week" => selectedDate.AddDays(-7),
        _ => selectedDate.AddMonths(-1)
    };

    private DateTime NextDate => selectedView switch
    {
        "day" => selectedDate.AddDays(1),
        "week" => selectedDate.AddDays(7),
        _ => selectedDate.AddMonths(1)
    };

    private string PeriodLabel => selectedView switch
    {
        "day" => selectedDate.ToString("MMMM d, yyyy"),
        "week" => $"{StartOfWeek(selectedDate):MMM d} – {StartOfWeek(selectedDate).AddDays(6):MMM d, yyyy}",
        _ => selectedDate.ToString("MMMM yyyy")
    };

    private static string CalendarUrl(string view, DateTime date) =>
        $"/calendar?view={view}&date={date:yyyy-MM-dd}";

    private string CreateSlotUrl(DateTime start) =>
        $"{CalendarUrl(selectedView, start.Date)}&slot={start:yyyy-MM-ddTHH:mm}#create-event";

    // App.razor sets <base href="/">. Fragment-only hrefs resolve against the
    // site root, not the calendar. Always include the calendar route and view.
    private string EventDetailsUrl(Guid id) =>
        $"{CalendarUrl(selectedView, selectedDate)}#event-{id:N}";

    private string CloseModalUrl => $"{CalendarUrl(selectedView, selectedDate)}#calendar-top";

    private string EditEventUrl(Guid id) =>
        $"{CalendarUrl(selectedView, selectedDate)}&edit={id:N}#edit-event";

    private DateTime NewEventStart =>
        DateTime.TryParseExact(SlotQuery, "yyyy-MM-ddTHH:mm",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var slot)
            && slot.Year is >= 2000 and <= 2100
            ? slot : selectedDate.Date.AddHours(20);

    private CalendarEvent? EditingEvent =>
        Guid.TryParse(EditQuery, out var id)
            ? visibleEvents.FirstOrDefault(ev => ev.Id == id)
            : null;

    private List<CalendarEvent> EventsOn(DateTime day) =>
        visibleEvents.Where(e => e.StartLocal < day.Date.AddDays(1)
            && e.EndLocal > day.Date)
            .OrderBy(e => e.StartLocal).ThenBy(e => e.Title).ToList();

    private static string EventCssClass(CalendarEvent ev) => ev.Category switch
    {
        "Fasting" => "frat-calendar-event frat-calendar-fasting",
        "Prayer" => "frat-calendar-event frat-calendar-prayer",
        "Fellowship" => "frat-calendar-event frat-calendar-fellowship",
        "Scripture" => "frat-calendar-event frat-calendar-scripture",
        "Other" => "frat-calendar-event frat-calendar-other",
        _ => "frat-calendar-event frat-calendar-meeting"
    };

    private static string EventTime(CalendarEvent ev) =>
        ev.StartLocal.TimeOfDay == TimeSpan.Zero
            && ev.EndLocal == ev.StartLocal.Date.AddDays(1)
            ? "All day · Eastern"
            : $"{ev.StartLocal:h:mm tt} – {ev.EndLocal:h:mm tt} Eastern";

    private List<CalendarEvent> events = [];
    private bool showDailyPrayer = true;
    private readonly HashSet<string> hiddenCategories = new(StringComparer.OrdinalIgnoreCase);
    private bool showUsHolidays = true;
    private bool showCatholicHolidays = true;
    private bool catholicUnavailable;
    private bool catholicStale;
    private List<CalendarObservance> observances = [];
    private List<CalendarObservance> ObservancesOn(DateTime day) =>
        observances.Where(h => h.Date == day.Date).OrderBy(h => h.Kind == "us" ? 0 : 1).ToList();
    private static string HolidayCss(CalendarObservance h) =>
        h.Kind == "us" ? "frat-observance frat-observance-us" : "frat-observance frat-observance-catholic";
    private static string HolidayTitle(CalendarObservance h) =>
        h.Obligation ? h.Rank + " · Holy day of obligation (US calendar)" : h.Rank;

    protected override async Task OnParametersSetAsync()
    {
        observances = [];
        catholicUnavailable = false;
        catholicStale = false;
        IEnumerable<DateTime> dates = selectedView switch { "month" => MonthDays, "week" => WeekDays, _ => new[] { selectedDate } };
        foreach (var year in dates.Select(d => d.Year).Distinct())
        {
            if (showUsHolidays) observances.AddRange(HolidayCalendarService.UnitedStates(year));
            if (showCatholicHolidays)
            {
                var result = await Holidays.CatholicAsync(year);
                observances.AddRange(result.Days);
                catholicUnavailable |= !result.Available;
                catholicStale |= result.Stale;
            }
        }
    }
    private List<CalendarEvent> visibleEvents => events.Where(e => !hiddenCategories.Contains(e.Category)
        && (showDailyPrayer || e.Category != "Prayer" || e.Title != "Daily prayer & Examen")).ToList();
    private List<Reading> readings = [];
    private bool isAdmin;
    private bool canCreate;
    private string? currentUserId;
    private bool CanEdit(CalendarEvent ev) => canCreate && (isAdmin ||
        (ev.CreatedByUserId is not null && ev.CreatedByUserId == currentUserId));

    protected override async Task OnInitializedAsync()
    {
        var state = await Authentication.GetAuthenticationStateAsync();
        canCreate = await Access.IsGroupMemberAsync(state.User);
        isAdmin = await Access.IsAdministratorAsync(state.User);
        currentUserId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        showDailyPrayer = await Preferences.GetBooleanAsync(
            state.User, UserPreferencesService.CalendarShowDailyPrayer, true);
        foreach (var category in UserPreferencesService.CalendarEventCategories)
            if (!await Preferences.GetBooleanAsync(state.User, UserPreferencesService.CategoryPreference(category), true))
                hiddenCategories.Add(category);
        showUsHolidays = await Preferences.GetBooleanAsync(state.User, UserPreferencesService.CalendarShowUsHolidays, true);
        showCatholicHolidays = await Preferences.GetBooleanAsync(state.User, UserPreferencesService.CalendarShowCatholicHolidays, true);
        await using var db = await DbFactory.CreateDbContextAsync();
        readings = await db.Readings.AsNoTracking().OrderBy(r => r.Week).ToListAsync();
        await ReloadEvents();
    }

    private async Task ReloadEvents()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        events = await db.CalendarEvents.AsNoTracking().Where(e => e.GroupId == 1)
            .OrderBy(e => e.StartLocal).ToListAsync();
    }

}
