@page "/discussions/{Id:guid}"
@attribute [Authorize]
@inject IDbContextFactory<FraternityDb> DbFactory

<PageTitle>Discussion | Fraternitas</PageTitle>
@if (post is null)
{
    <section class="panel"><h1>Discussion not found</h1><a href="/discussions">Back</a></section>
}
else
{
    <div class="page-head">
        <div class="eyebrow">GROUP DISCUSSION</div>
        <h1>@post.Title</h1>
        <p>Started by @(post.Author?.DisplayName ?? "Member") · @post.CreatedUtc.ToLocalTime().ToString("MMM d, yyyy")</p>
    </div>
    <section class="panel">
        <p class="pre-line">@post.Body</p>
    </section>
    <BibleBrowser DiscussionId="@Id" BookQuery="@BibleBook"
                  ChapterQuery="@BibleChapter" VerseQuery="@BibleVerse" />
    <section class="panel">
        <h2>Replies (@post.Replies.Count)</h2>
        @if (PinError == "failed")
        {
            <p class="error" role="alert">The verse could not be pinned. Verify your access and try again.</p>
        }
        @foreach (var reply in post.Replies.OrderBy(r => r.CreatedUtc))
        {
            <div class="reply">
                <div class="reply-meta"><strong>@(reply.Author?.DisplayName ?? "Member")</strong>
                    <small>@reply.CreatedUtc.ToLocalTime().ToString("MMM d, h:mm tt")</small></div>
                <p class="pre-line">@reply.Body</p>
            </div>
        }

        <h3>Add a reply</h3>
        <form method="post" action="@($"/discussions/{Id}/reply")" data-enhance="false">
            <AntiforgeryToken />
            <label>Your response<textarea name="message" rows="4" maxlength="3000" required></textarea></label>
            @if (ReplyError == "invalid")
            {
                <p class="error" role="alert">Enter a reply before posting.</p>
            }
            <div class="button-row">
                <button class="action" type="submit">Reply</button>
                <a class="action secondary" href="/discussions">All discussions</a>
            </div>
        </form>
    </section>
}

@code {
    [Parameter] public Guid Id { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "error")]
    public string? ReplyError { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "book")]
    public string? BibleBook { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "chapter")]
    public int? BibleChapter { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "verse")]
    public int? BibleVerse { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "pin")]
    public string? PinError { get; set; }

    private Discussion? post;

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        post = await db.Discussions.AsNoTracking().Include(d => d.Author)
            .Include(d => d.Replies).ThenInclude(r => r.Author)
            .FirstOrDefaultAsync(d => d.Id == Id && d.GroupId == 1);
    }
}
