@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<FraternityDb> DbFactory
@inject NavigationManager Navigation
@inject MemberAccessService Access

<PageTitle>Administration | Fraternitas</PageTitle>
<div class="page-head">
    <div class="eyebrow">ADMINISTRATION</div>
    <h1>Manage the group</h1>
    <p>Invite members and manage the group's calendar.</p>
</div>
<div class="dashboard-grid">
    <section class="panel">
        <h2>One link for the whole group</h2>
        <p>Generate a single invitation link and share it in the group chat. Every man can
           register his own account using the <strong>same link</strong>, as many times as needed.
           The invitation expires after seven days, or sooner if you revoke it.</p>
        <p class="muted small"><strong>Access notice:</strong> anyone who registers with this link
           becomes an Administrator by default, including access to event management, invitations,
           and member roles. Only share it with people you trust.</p>
        @if (Navigation.ToAbsoluteUri("/").IsLoopback)
        {
            <p class="error">This site is running on localhost. The invitation URL will
                only work on this computer until you host Fraternitas at an address everyone
                can reach. Do not send a localhost link to the group.</p>
        }
        <form method="post" action="/admin/invitations/create" data-enhance="false">
            <AntiforgeryToken />
            <button class="action" type="submit">Create group invitation link</button>
        </form>

        <h3>Active shared links</h3>
        @if (activeInvites.Count == 0)
        {
            <p class="muted">No active invitation links. Generate one to invite the group.</p>
        }
        @foreach (var invitation in activeInvites)
        {
            <div class="list-row">
                <span style="flex: 1">
                    <strong>Group invitation</strong>
                    <small>Expires @invitation.ExpiresUtc.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</small>
                </span>
                <form method="post" action="/admin/invitations/revoke" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="invitationId" value="@invitation.Id" />
                    <button class="danger-button" type="submit">Revoke</button>
                </form>
            </div>
        }
        <p class="muted small">Anyone with an active link may join, so share it only with intended members.
            Revoking stops future registrations, but doesn't remove existing accounts.</p>
    </section>
    <section class="panel">
        <h2>Group overview</h2>
        <p><strong>@memberCount</strong> registered members</p>
        <p><strong>@eventCount</strong> scheduled events</p>
        <p><strong>@outstandingInvites</strong> active invitation links</p>
        <a class="action secondary" href="/calendar">Manage calendar</a>
    </section>
</div>

<section class="panel" id="account-requests">
    <div class="section-head">
        <h2>Account requests</h2>
        <span class="muted">@accountRequests.Count requests</span>
    </div>
    <p>Review requests to join the group. Approval sends a private, single-use registration link to the applicant.
        No account exists until the applicant completes registration.</p>
    @if (ActionStatus == "request-deleted")
    {
        <p class="upload-success" role="status">Request deleted and any registration link revoked.</p>
    }
    @if (accountRequests.Count == 0)
    {
        <p class="muted">No outstanding account requests.</p>
    }
    @foreach (var request in accountRequests)
    {
        var active = request.ExpiresUtc > DateTime.UtcNow;
        <div class="member-access-row" @key="request.Id">
            <div class="member-access-identity">
                <strong>@request.DisplayName</strong>
                <small>@request.Email</small>
                <small>Requested @TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(request.CreatedUtc, DateTimeKind.Utc), GroupClock.Zone).ToString("MMM d, yyyy")</small>
                @if (!string.IsNullOrWhiteSpace(request.Note))
                {
                    <p class="small pre-line">@request.Note</p>
                }
                <small>@(active ? "Approved · registration pending" : request.ExpiresUtc.HasValue ? "Link expired" : "Awaiting approval")</small>
            </div>
            <div class="member-access-controls">
                <form method="post" action="/admin/account-requests/approve" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="requestId" value="@request.Id" />
                    <label class="small">Access on registration
                        <select name="grantAdmin">
                            <option value="false" selected="@(!request.GrantAdmin)">Member only</option>
                            <option value="true" selected="@request.GrantAdmin">Administrator</option>
                        </select>
                    </label>
                    <button type="submit" class="action compact">@(active ? "Resend registration link" : "Approve & email registration link")</button>
                </form>
                <form method="post" action="/admin/account-requests/delete" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="requestId" value="@request.Id" />
                    <button type="submit" class="danger-button">Delete request</button>
                </form>
            </div>
        </div>
    }
</section>

<section class="panel">
    <div class="section-head">
        <div>
            <div class="eyebrow">EMAIL DELIVERY</div>
            <h2>Send test email</h2>
        </div>
        <span class="muted small">Resend</span>
    </div>
    <p>Send a real test message to confirm that Fraternitas can deliver email through Resend.</p>
    <p class="muted small">The Resend API key is read from the Pi's <code>RESEND_API_KEY</code> environment setting.
       Never paste an API key into a web form or commit it to GitHub.
       For a sender other than Resend's testing address, verify your domain in Resend first.</p>
    <form method="post" action="/admin/email/test" data-enhance="false">
        <AntiforgeryToken />
        <label>Test recipient
            <input type="email" name="recipient" value="alex@moir.pw" maxlength="254" required />
        </label>
        <button class="action" type="submit">Send test email</button>
    </form>
</section>

<section class="panel">
    <div class="section-head"><h2>Member access</h2><span class="muted">@members.Count accounts</span></div>
    <p>All group members are <strong>Administrators by default</strong>. You can explicitly switch a person
       to <strong>Member only</strong> if they should not manage the calendar, invitations, or other members.</p>
    <p class="muted small">Role changes are saved permanently. The affected member should sign out and back
       in (or fully reload their session) for the updated access to take effect.</p>
    <p class="muted small"><strong>Password help:</strong> members can request an emailed reset from the login page.
       Select <strong>Reset password</strong> beside any member to email them a fresh, single-use link.
       If delivery is unavailable, copy the link and send it privately instead. Never share it in the group chat.</p>

    @if (ActionStatus == "role-saved")
    {
        <p class="upload-success" role="status">Member access saved.</p>
    }
    else if (ActionStatus == "invite-revoked")
    {
        <p class="upload-success" role="status">The invitation was revoked.</p>
    }
    else if (ActionStatus == "failed")
    {
        <p class="error" role="alert">The requested change could not be saved. Reload the page and try again.</p>
    }

    @foreach (var member in members)
    {
        <div class="member-access-row" @key="member.Id">
            <div class="member-access-identity">
                <strong>@member.DisplayName</strong>
                <small>@member.Email</small>
            </div>
            <div class="member-access-controls">
                <span class="member-access-role">@(member.IsMemberOnly ? "Member only" : "Administrator")</span>
                @if (resetRequests.Contains(member.Id))
                {
                    <span class="member-reset-requested">Reset requested</span>
                }
                <form method="post" action="/admin/members/password-reset" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="userId" value="@member.Id" />
                    <button type="submit" class="action secondary compact">Reset password</button>
                </form>
                @if (member.IsMemberOnly)
                {
                    <form method="post" action="/admin/members/role" data-enhance="false">
                        <AntiforgeryToken />
                        <input type="hidden" name="userId" value="@member.Id" />
                        <input type="hidden" name="memberOnly" value="false" />
                        <button type="submit" class="action secondary compact">Make administrator</button>
                    </form>
                }
                else
                {
                    <form method="post" action="/admin/members/role" data-enhance="false">
                        <AntiforgeryToken />
                        <input type="hidden" name="userId" value="@member.Id" />
                        <input type="hidden" name="memberOnly" value="true" />
                        <button type="submit" class="action secondary compact">Set member only</button>
                    </form>
                }
            </div>
        </div>
    }
</section>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "status")]
    public string? ActionStatus { get; set; }

    private List<Invitation> activeInvites = [];
    private List<AccountRequest> accountRequests = [];
    private int memberCount;
    private int eventCount;
    private int outstandingInvites;
    private List<MemberAccessRow> members = [];
    private HashSet<string> resetRequests = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        accountRequests = await db.AccountRequests.AsNoTracking()
            .OrderBy(r => r.CreatedUtc).ToListAsync();
        memberCount = await db.Users.CountAsync(u => u.GroupId == 1);
        eventCount = await db.CalendarEvents.CountAsync(e => e.GroupId == 1);
        activeInvites = await db.Invitations.AsNoTracking()
            .Where(i => i.GroupId == 1 && i.RedeemedUtc == null && i.ExpiresUtc > DateTime.UtcNow)
            .OrderBy(i => i.ExpiresUtc).ToListAsync();
        outstandingInvites = activeInvites.Count;
        members = await Access.GetMembersAsync();
        resetRequests = (await db.Set<Microsoft.AspNetCore.Identity.IdentityUserToken<string>>()
            .AsNoTracking()
            .Where(t => t.LoginProvider == PasswordRecoveryEndpoints.Provider
                && t.Name == PasswordRecoveryEndpoints.RequestName)
            .Select(t => t.UserId).ToListAsync()).ToHashSet();
    }
}
