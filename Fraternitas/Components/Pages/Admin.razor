@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<FraternityDb> DbFactory
@inject NavigationManager Navigation
@inject MemberAccessService Access
@inject AuthenticationStateProvider Authentication

<PageTitle>Administration | Fraternitas</PageTitle>
<div class="page-head">
    <div class="eyebrow">ADMINISTRATION</div>
    <h1>Manage the group</h1>
    <p>Invite members and manage the group's calendar.</p>
</div>
<div class="dashboard-grid">
    <section class="panel">
        <h2>One link for the whole group</h2>
        <p>Generate a single invitation link and share it in the group chat. Every man can
           register his own account using the <strong>same link</strong>, as many times as needed.
           The invitation expires after seven days, or sooner if you revoke it.</p>
        <p class="muted small"><strong>Access notice:</strong> anyone who registers with this link
           becomes an Administrator by default, including access to event management, invitations,
           and member roles. Only share it with people you trust.</p>
        @if (Navigation.ToAbsoluteUri("/").IsLoopback)
        {
            <p class="error">This site is running on localhost. The invitation URL will
                only work on this computer until you host Fraternitas at an address everyone
                can reach. Do not send a localhost link to the group.</p>
        }
        <button class="action" @onclick="CreateInvitation">Create group invitation link</button>
        @if (!string.IsNullOrEmpty(invitationUrl))
        {
            <label>Share this invitation URL with the group
                <input readonly value="@invitationUrl" onclick="this.select()" />
            </label>
            <p class="muted small">Copy and save this URL now. For security, only its hash
                is stored, so the full link cannot be shown again later.</p>
        }

        <h3>Active shared links</h3>
        @if (activeInvites.Count == 0)
        {
            <p class="muted">No active invitation links. Generate one to invite the group.</p>
        }
        @foreach (var invitation in activeInvites)
        {
            <div class="list-row">
                <span style="flex: 1">
                    <strong>Group invitation</strong>
                    <small>Expires @invitation.ExpiresUtc.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</small>
                </span>
                <button class="danger-button" @onclick="() => RevokeInvitation(invitation.Id)">Revoke</button>
            </div>
        }
        <p class="muted small">Anyone with an active link may join, so share it only with intended members.
            Revoking stops future registrations, but doesn't remove existing accounts.</p>
    </section>
    <section class="panel">
        <h2>Group overview</h2>
        <p><strong>@memberCount</strong> registered members</p>
        <p><strong>@eventCount</strong> scheduled events</p>
        <p><strong>@outstandingInvites</strong> active invitation links</p>
        <a class="action secondary" href="/calendar">Manage calendar</a>
    </section>
</div>

<section class="panel">
    <div class="section-head"><h2>Member access</h2><span class="muted">@members.Count accounts</span></div>
    <p>All group members are <strong>Administrators by default</strong>. You can explicitly switch a person
       to <strong>Member only</strong> if they should not manage the calendar, invitations, or other members.</p>
    <p class="muted small">Role changes are saved permanently. The affected member should sign out and back
       in (or fully reload their session) for the updated access to take effect.</p>

    @if (!string.IsNullOrEmpty(roleError))
    {
        <p class="error" role="alert">@roleError</p>
    }
    @if (!string.IsNullOrEmpty(roleMessage))
    {
        <p class="muted" role="status">@roleMessage</p>
    }

    @foreach (var member in members)
    {
        <div class="member-access-row" @key="member.Id">
            <div class="member-access-identity">
                <strong>@member.DisplayName</strong>
                <small>@member.Email</small>
            </div>
            <div class="member-access-controls">
                <span class="member-access-role">@(member.IsMemberOnly ? "Member only" : "Administrator")</span>
                @if (member.IsMemberOnly)
                {
                    <button type="button" class="action secondary compact" disabled="@changingRole"
                            @onclick="() => ChangeRole(member.Id, false)">Make administrator</button>
                }
                else
                {
                    <button type="button" class="action secondary compact" disabled="@changingRole"
                            @onclick="() => ChangeRole(member.Id, true)">Set member only</button>
                }
            </div>
        </div>
    }
</section>

@code {
    private string invitationUrl = "";
    private Guid? newlyCreatedInviteId;
    private List<Invitation> activeInvites = [];
    private int memberCount;
    private int eventCount;
    private int outstandingInvites;
    private List<MemberAccessRow> members = [];
    private string roleError = "";
    private string roleMessage = "";
    private bool changingRole;

    protected override async Task OnInitializedAsync() => await LoadCounts();

    private async Task LoadCounts()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        memberCount = await db.Users.CountAsync(u => u.GroupId == 1);
        eventCount = await db.CalendarEvents.CountAsync(e => e.GroupId == 1);
        activeInvites = await db.Invitations.AsNoTracking()
            .Where(i => i.GroupId == 1 && i.RedeemedUtc == null && i.ExpiresUtc > DateTime.UtcNow)
            .OrderBy(i => i.ExpiresUtc).ToListAsync();
        outstandingInvites = activeInvites.Count;
        members = await Access.GetMembersAsync();
    }

    private async Task CreateInvitation()
    {
        if (!await Access.IsAdministratorAsync((await Authentication.GetAuthenticationStateAsync()).User))
        {
            roleError = "Your administrator access has changed. Please sign in again.";
            return;
        }
        var code = AccountEndpoints.NewToken();
        await using var db = await DbFactory.CreateDbContextAsync();
        var invitation = new Invitation
        {
            TokenSha256 = AccountEndpoints.Hash(code),
            ExpiresUtc = DateTime.UtcNow.AddDays(7),
            GroupId = 1
        };
        db.Invitations.Add(invitation);
        await db.SaveChangesAsync();
        newlyCreatedInviteId = invitation.Id;
        invitationUrl = Navigation.ToAbsoluteUri("/account/join?code=" + Uri.EscapeDataString(code)).ToString();
        await LoadCounts();
    }

    private async Task RevokeInvitation(Guid invitationId)
    {
        if (!await Access.IsAdministratorAsync((await Authentication.GetAuthenticationStateAsync()).User))
        {
            roleError = "Your administrator access has changed. Please sign in again.";
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var invitation = await db.Invitations.FirstOrDefaultAsync(i =>
            i.Id == invitationId && i.GroupId == 1 && i.RedeemedUtc == null);
        if (invitation is null) return;

        // Reuse the legacy RedeemedUtc field as a deactivation marker.
        // Avoid an EF schema change for existing installed SQLite databases.
        invitation.RedeemedUtc = DateTime.UtcNow;
        await db.SaveChangesAsync();
        if (newlyCreatedInviteId == invitationId)
        {
            invitationUrl = "";
            newlyCreatedInviteId = null;
        }
        await LoadCounts();
    }
    private async Task ChangeRole(string userId, bool memberOnly)
    {
        if (changingRole) return;
        changingRole = true;
        roleError = "";
        roleMessage = "";
        try
        {
            var state = await Authentication.GetAuthenticationStateAsync();
            await Access.SetMemberOnlyAsync(state.User, userId, memberOnly);
            await LoadCounts();
            roleMessage = memberOnly
                ? "Member-only access saved. The user should sign in again."
                : "Administrator access restored. The user should sign in again.";

            if (memberOnly && state.User.FindFirstValue(ClaimTypes.NameIdentifier) == userId)
            {
                // Don't keep using the current interactive admin circuit after self-demotion.
                Navigation.NavigateTo("/account/logout", forceLoad: true);
            }
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException
            or ArgumentException or InvalidOperationException)
        {
            roleError = ex.Message;
        }
        finally
        {
            changingRole = false;
        }
    }

}
