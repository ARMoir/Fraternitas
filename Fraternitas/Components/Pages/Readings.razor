@page "/readings"
@attribute [Authorize]
@inject IDbContextFactory<FraternityDb> DbFactory
@inject CatholicBibleService Bible

<PageTitle>Readings | Fraternitas</PageTitle>
<div class="page-head">
    <div class="eyebrow">LECTIO DIVINA</div>
    <h1>The Five Joyful Mysteries</h1>
    <p>Read each passage three times, moving from observation to meaning to personal application.</p>
    <p class="muted small">Scripture from the Douay–Rheims 1899 Catholic Bible via HelloAO, with the full Catholic canon verified before loading.</p>
    @if (PinError == "invalid")
    {
        <p class="error" role="alert">Choose a valid Scripture verse and reflection.</p>
    }
    else if (PinError == "failed")
    {
        <p class="error" role="alert">The verse could not be pinned. Verify your access and try again.</p>
    }
    @if (DiscussionId.HasValue)
    {
        <p class="muted">Choose a verse and select <strong>Pin in this discussion</strong> to share it as a reply.</p>
    }
    else
    {
        <p class="muted">Use the <strong>Pin</strong> button beside a verse to share it in Discussions, or add it to the calendar as an administrator.</p>
    }
</div>

@foreach (var reading in readings)
{
    <section class="panel reading">
        <div class="eyebrow">WEEK @reading.Week</div>
        <h2>@reading.Title</h2>
        <p class="scripture">@reading.Scripture</p>
        <p>@reading.Summary</p>
        <ScripturePassageView Passage="@GetPassage(reading.Week)" Expanded="@(reading.Week == 1)" DiscussionId="@DiscussionId" />
        <div class="prompts">
            <div><strong>First reading · Listen</strong><p>What words, images or details stand out?</p></div>
            <div><strong>Second reading · Reflect</strong><p>What deeper meaning is God revealing in this passage?</p></div>
            <div><strong>Third reading · Respond</strong><p>How does this speak to my life, and how will I respond?</p></div>
        </div>
        <p class="muted small">Close the gathering with one decade of the Rosary.</p>
    </section>
}

@code {
    [Parameter, SupplyParameterFromQuery(Name = "discussionId")]
    public Guid? DiscussionId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "pin")]
    public string? PinError { get; set; }

    private List<Reading> readings = [];
    private Dictionary<int, CatholicPassage> passages = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        readings = await db.Readings.AsNoTracking().OrderBy(r => r.Week).ToListAsync();

        // Render the Scripture passages as part of the initial HTML response.
        // OnAfterRenderAsync doesn't execute during static prerendering, so
        // fetching there left this page stuck on "Loading..." whenever the
        // Blazor Server circuit was unavailable.
        var loaded = await Task.WhenAll(readings.Select(async reading =>
            (Week: reading.Week, Passage: await Bible.GetPassageAsync(reading.Scripture))));
        passages = loaded.ToDictionary(item => item.Week, item => item.Passage);
    }

    private CatholicPassage? GetPassage(int week) =>
        passages.GetValueOrDefault(week);
}
